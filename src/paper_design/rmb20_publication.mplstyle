font.family: Arial
font.size: 9
axes.titlesize: 10
axes.labelsize: 9
axes.titleweight: bold
axes.labelcolor: #4E382B
axes.edgecolor: #7A5A45
axes.linewidth: 0.8
axes.facecolor: #FFFDFC
figure.facecolor: #FFFDFC
text.color: #3F3027
xtick.color: #5B4638
ytick.color: #5B4638
xtick.labelsize: 8
ytick.labelsize: 8
grid.color: #DED2C5
grid.linewidth: 0.55
grid.alpha: 0.55
legend.frameon: False
legend.fontsize: 8
lines.linewidth: 1.8
lines.markersize: 5
savefig.facecolor: #FFFDFC
savefig.bbox: tight
savefig.pad_inches: 0.04
svg.fonttype: none
pdf.fonttype: 42
ps.fonttype: 42
mathtext.fontset: stixsans

