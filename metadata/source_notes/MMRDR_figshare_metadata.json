name": "_", "orcid_id": ""}, {"id": 21629027, "full_name": "Zhen Guo", "first_name": "Zhen", "last_name": "Guo", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 21624932, "full_name": "Xiaosong Wang", "first_name": "Xiaosong", "last_name": "Wang", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 21624934, "full_name": "Jun Li", "first_name": "Jun", "last_name": "Li", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/MMRDR/29423747", "download_disabled": false, "description": "<h2>Multi-Modal Retinal images for in-depth DR analysis (MMRDR)</h2><p dir=\"ltr\">Diabetic Retinopathy (DR) is a leading cause of preventable blindness worldwide, particularly among working-age adults. We present a multi-modal retinal images dataset, comprising 11,118 CFP images, 10,404 UWF images and 2,938 OCT images. CFP and UWF images are annotated with 5 DR severity grades and 7 DR-related lesions, while OCT images are annotated with 3 DME severity classes.</p>", "funding": null, "funding_list": [], "version": 2, "status": "public", "size": 18610320190, "created_date": "2025-07-01T02:56:56Z", "modified_date": "2025-07-01T02:56:56Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["diabetic retinopathy"], "keywords": ["diabetic retinopathy"], "categories": [{"id": 24817, "title": "Ophthalmology", "parent_id": 24814, "path": "/24457/24814/24817", "source_id": "321201", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Tang, Zhenyu; Wang, Lilong; Liang, Qianqian; Xue, Shuyue; Feng, Chengcheng; Ran, Lili; et al. (2025). MMRDR. figshare. Dataset. https://doi.org/10.6084/m9.figshare.29423747.v2", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type":